{
  "askcliResourcesVersion": "2020-03-31",
  "profiles": {
    "default": {
      "skillMetadata": {
        "src": "./skill-package"
      },
      "code": {
        "default": {
          "src": "./lambda"
        }
      },
      "skillInfrastructure": {
        "type": "@ask-cli/lambda-deployer",
        "userConfig": {
          "awsRegion": "us-west-2",
          "runtime": "python3.12",
          "handler": "lambda_function.handler",
          "lambda": {
            "functionName": "ship-alexa-skill",
            "description": "SHIP Review: Alexa skill that stands in for an Alexa+ add-on and calls Relay over MCP",
            "memorySize": 256,
            "timeout": 8,
            "environmentVariables": {
              "SHIP_RELAY_URL": "https://4f5g7mxyhhhhctmbagr5syfloa0airkl.lambda-url.us-west-2.on.aws/mcp",
              "SHIP_ALEXA_USERS_TABLE": "ship-alexa-users"
            }
          }
        }
      }
    }
  }
}